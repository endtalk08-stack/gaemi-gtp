[Unit]
Description=Retired: US TOP20 AI move analysis (stopped 2026-11-28 at the owner's request, never fires)

[Timer]
# A date in the past never elapses again: the AI analysis does not run.
OnCalendar=2000-01-01 00:00:00 UTC
Unit=gaemigtp-us-news-ai.service
Persistent=false

[Install]
WantedBy=timers.target
