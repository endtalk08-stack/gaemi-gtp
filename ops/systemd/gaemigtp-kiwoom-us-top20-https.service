[Unit]
Description=gaemiGTP Kiwoom US TOP20 TLS ingress (Cloudflare origin)
After=network-online.target gaemigtp-kiwoom-us-top20-api.service
Wants=network-online.target

[Service]
Type=simple
User=gaemigtp-news
Group=gaemigtp-news
WorkingDirectory=/opt/gaemigtp-news/app
ExecStart=/opt/gaemigtp-news/venv/bin/python -m backend.kiwoom_us_top20_api --tls
Restart=on-failure
RestartSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
