[Unit]
Description=gaemiGTP US macro headlines (Fed, White House, BEA) translated to Korean (DeepL, R2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gaemigtp-news
Group=gaemigtp-news
EnvironmentFile=/var/lib/gaemigtp-news/r2.env
EnvironmentFile=-/var/lib/gaemigtp-news/translate.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/gaemigtp-news/app
ExecStart=/opt/gaemigtp-news/venv/bin/python -m backend.us_macro_news
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gaemigtp-news
