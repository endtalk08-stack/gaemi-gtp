[Unit]
Description=gaemiGTP Kiwoom US daily candles for verified trading-value Top 20
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gaemigtp-news
Group=gaemigtp-news
WorkingDirectory=/opt/gaemigtp-news/app
EnvironmentFile=/etc/gaemigtp/kiwoom.env
EnvironmentFile=/etc/gaemigtp/news-worker.env
ExecStart=/opt/gaemigtp-news/venv/bin/python -m backend.kiwoom_us_daily_collector
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
