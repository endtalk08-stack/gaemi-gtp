[Unit]
Description=gaemiGTP verified US daily chart collection and R2 publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gaemigtp-news
Group=gaemigtp-news
WorkingDirectory=/opt/gaemigtp-news/app
EnvironmentFile=/etc/gaemigtp/news-worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/gaemigtp-news/venv/bin/python -m backend.kiwoom_us_daily_collector
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
