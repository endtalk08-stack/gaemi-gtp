#!/usr/bin/env bash
# gaemiGTP project management gateway.
# Fixed, root-owned entry point for pre-authorized GitHub Actions SSH user.
set -Eeuo pipefail
umask 077

fail() { echo "GAEMI_GATEWAY_ERROR=$*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || fail "root_only"
[[ -f /opt/gaemigtp-news/app/backend/services/us_market_close.py ]] || fail "missing_app"
[[ -x /opt/gaemigtp-news/venv/bin/python ]] || fail "missing_venv"
command -v flock >/dev/null || fail "flock_required"

app=/opt/gaemigtp-news/app
inbox=/home/gaemi-deploy/.gaemi-gateway/payload
envfile=/etc/gaemigtp/news-worker.env
action="$1"
shift || true

valid_sha() { [[ "$1" =~ ^[a-f0-9]{40}$ ]]; }
blob_sha() { git hash-object -- "$1"; }
valid_unit() { [[ "$1" =~ ^gaemigtp-[A-Za-z0-9_.@-]{1,100}\.(service|timer)$ ]]; }
valid_req() { [[ "$1" =~ ^[a-zA-Z0-9_-]{8,55}$ ]]; }
valid_timeout() { [[ "$1" =~ ^[0-9]{1,4}$ ]] && (( 30 <= $1 && $1 <= 900 )); }

case "$action" in
  cleanup)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    exec 8>/run/lock/gaemi-gateway.lock
    flock -n 8 || fail "concurrent_operation"
    [[ "$(systemctl is-active gaemigtp-news.service || true)" != "active" ]] || fail "news_worker_active_abort"
    for proc in apt apt-get dpkg; do
      pgrep -x "$proc" >/dev/null 2>&1 && fail "package_manager_busy"
    done

    apt_before=$(du -sb /var/cache/apt 2>/dev/null | awk '{print $1}')
    apt-get clean
    rm -f -- /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin
    apt_after=$(du -sb /var/cache/apt 2>/dev/null | awk '{print $1}')

    pyc_count=$(find "$app" -xdev -type f -name '*.pyc' -printf '.' | wc -c)
    pyc_bytes=$(find "$app" -xdev -type f -name '*.pyc' -printf '%s\n' | awk '{s+=$1} END {print s+0}')
    find "$app" -xdev -type f -name '*.pyc' -delete
    find "$app" -xdev -depth -type d -name '__pycache__' -empty -delete

    temp_removed=0
    for name in \
      .us-identity-next-news.py \
      .us-code-next-result.py \
      .next-shared-news-result.py \
      .news-result-facts-v2.next \
      .verified-title-result-next.py \
      .news-result-facts-next.py \
      .news-coverage-result.next \
      .next-shared-news-feed.py \
      .us-identity-next-store.py \
      .us-code-next-store.py \
      .next-shared-processed-store.py \
      .article-facts-v2.next \
      .kiwoom-value-identity.next \
      .article-facts-next.py \
      .ai-primary-store.next \
      .identity-store.next; do
      f="$app/ops/$name"
      [[ -f "$f" && ! -L "$f" ]] || continue
      find "$f" -maxdepth 0 -type f -mmin +8640 -print -quit | grep -q . || continue
      if grep -R -F -l -- "$name" "$app/backend" "$app/frontend" "$app/app.py" "$app/ops/systemd" /etc/systemd/system/gaemigtp-* 2>/dev/null | grep -v -F -- "$f" >/dev/null; then
        continue
      fi
      rm -f -- "$f"
      temp_removed=$((temp_removed+1))
    done

    reviewed_removed=0
    reviewed_bytes=0
    reviewed_candidates=(
      "staged_daily_issue_schedule.py:f7ab637f217d864bd9ffed59d168eff962b4d358411a6f9a3818b1f34ed187bd"
      "staged_news_processed_store.py:1681815be7359bbce0d905efc0c3db50315ae93cb616051320fee887dde94cdb"
      ".us-code-next-result.py:95a1c3ad9f47fb86cee9a1997219490a5c391c228a34d5f5461bbc7df37f37dd"
      "staged_ai_issue_display_adapter.py:fb6bd641025239bd771103a5fa3227fab52976088da9da51d777384bcd787f62"
      ".next-shared-news-result.py:6436c852a8d12578c046eb6c45fbb08d2fc55f9b09710127396a5ea54554f953"
      ".next-shared-source-meta.py:a7bed667d6fe105abe92293ee9b94ad4048a7d46b008dfaef144cb2ea765d1bc"
      ".news-coverage-rank-patch.next:e7ee06e85b83fe500583f92b6a774aa18e9639355e51f35626d8f7de86b28212"
      ".next-shared-news-feed.py:a4544237a20b45cc02ddf9a320741acd6a5c2c04c6a9db20e503442a5834c7a0"
      ".identity-resolver.next:b7c6d733eff2affa9cb4088b88b4522ec74afd62be1111391445c3c06745dff8"
      ".news-coverage-catalog.next:ef8200ce8513e972009e71f6440f67a25dcf6dfb68db8c0dbd989fd3993cc75c"
      ".us-code-next-store.py:808f110c408260b0adf1f564741820d8f43705a7c6ccba4745fccfbd8b5f018d"
      ".us-identity-next-news.py:0f79aeb99a5931f22273ce4250c8cc3c9eca08734811add49c5ffd7a798f7a58"
      "staged_news_rank_queue_patch.py:e7ee06e85b83fe500583f92b6a774aa18e9639355e51f35626d8f7de86b28212"
      ".us-identity-next-store.py:24b488568a5354c7fd7c8dab50cd28c880022bc06e8f2ad2893508e52fc8a156"
      ".identity-catalog.next:27eca973c92c98fbee0b13d3c448fd705a1c371fb73bf0f8fec2ec656eea428e"
      "staged_daily_call_guard.py:aaa04a963104ec275338428a2ec699cd2e3fe682b181b6032125374aa8494d6b"
      ".us-code-next-citations.py:2aada3aad3f18ad1d42e383efadd3c08c39e4cfae3c6bdcc819d43b985120d1a"
      ".next-shared-processed-store.py:ca27f46367a8751b316af773a6663173501736a9d366665db9e93665a54b352e"
      "staged_ai_snapshot_integration.py:1677d26584377132ffdb51eaf2eaa8590498079042c54a78535b3f666d79dae3"
    )
    search_roots=("$app/backend" "$app/frontend" "$app/app.py" "$app/ops" /etc/systemd/system)
    for root in /etc/cron.d /etc/cron.daily /etc/cron.hourly; do
      [[ -e "$root" ]] && search_roots+=("$root")
    done
    for spec in "${reviewed_candidates[@]}"; do
      name="${spec%%:*}"
      expected="${spec#*:}"
      f="$app/ops/$name"
      [[ -e "$f" || -L "$f" ]] || continue
      [[ -f "$f" && ! -L "$f" ]] || fail "reviewed_staging_unexpected_type:$name"
      find "$f" -maxdepth 0 -type f -mtime +7 -print -quit | grep -q . || fail "reviewed_staging_too_recent:$name"
      actual=$(sha256sum -- "$f" | awk '{print $1}')
      [[ "$actual" == "$expected" ]] || fail "reviewed_staging_hash_mismatch:$name"
      if grep -R -F -l --exclude=gaemi-do-gateway --exclude=audit_server_staging_refs_20261101.py --exclude=cleanup_reviewed_staging_20261101.py -- "$name" "${search_roots[@]}" 2>/dev/null | grep -v -F -- "$f" >/dev/null; then
        fail "reviewed_staging_now_referenced:$name"
      fi
      bytes=$(stat -c %s -- "$f")
      rm -f -- "$f"
      [[ ! -e "$f" && ! -L "$f" ]] || fail "reviewed_staging_delete_failed:$name"
      reviewed_removed=$((reviewed_removed+1))
      reviewed_bytes=$((reviewed_bytes+bytes))
      echo "GAEMI_REVIEWED_STAGING_DELETED=$name"
    done

    stale_jobs=0
    if [[ -d /run/gaemi-gateway ]]; then
      stale_jobs=$(find /run/gaemi-gateway -maxdepth 1 -type f -name 'job-*.py' -mmin +1440 -print | wc -l)
      find /run/gaemi-gateway -maxdepth 1 -type f -name 'job-*.py' -mmin +1440 -delete
    fi
    old_runs=0
    if [[ -d /var/lib/gaemi-gateway ]]; then
      old_runs=$(find /var/lib/gaemi-gateway -maxdepth 1 -type f -name 'run-*' -mtime +90 -print | wc -l)
      find /var/lib/gaemi-gateway -maxdepth 1 -type f -name 'run-*' -mtime +90 -delete
    fi
    if [[ -f "$inbox" && ! -L "$inbox" ]]; then rm -f -- "$inbox"; fi

    journalctl --vacuum-size=256M
    echo "GAEMI_CLEANUP_APT_BYTES_BEFORE=$apt_before"
    echo "GAEMI_CLEANUP_APT_BYTES_AFTER=$apt_after"
    echo "GAEMI_CLEANUP_PYC_FILES_REMOVED=$pyc_count"
    echo "GAEMI_CLEANUP_PYC_BYTES_REMOVED=$pyc_bytes"
    echo "GAEMI_CLEANUP_STALE_OPS_TEMP_REMOVED=$temp_removed"
    echo "GAEMI_CLEANUP_STALE_JOB_FILES_REMOVED=$stale_jobs"
    echo "GAEMI_CLEANUP_OLD_RUN_RECORDS_REMOVED=$old_runs"
    journalctl --disk-usage
    df -h /
    echo "GAEMI_CLEANUP_DONE_SECURITY_LOGS_AND_ROLLBACK_BACKUPS_PRESERVED"
    ;;
  pause-market)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    systemctl disable --now gaemigtp-kiwoom-us-daily.timer gaemigtp-kiwoom-us-value.timer gaemigtp-kiwoom-us-fe.service
    systemctl stop gaemigtp-kiwoom-us-daily.service gaemigtp-kiwoom-us-value.service
    for unit in gaemigtp-kiwoom-us-daily.timer gaemigtp-kiwoom-us-value.timer gaemigtp-kiwoom-us-fe.service; do
      systemctl is-active --quiet "$unit" && fail "market_unit_still_active"
    done
    echo GAEMI_MARKET_PAUSED_SERVER_POWER_UNCHANGED
    ;;
  stop-news)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    systemctl disable --now gaemigtp-news.service
    systemctl is-active --quiet gaemigtp-news.service && fail "news_still_active"
    echo GAEMI_NEWS_STOPPED
    ;;

  alpaca-price-remove)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    [[ "$(systemctl is-active gaemigtp-news.service || true)" == inactive ]] || fail "news_worker_not_paused"
    [[ -f "$app/backend/alpaca_news_probe.py" && ! -L "$app/backend/alpaca_news_probe.py" ]] || fail "alpaca_news_probe_missing_abort"
    [[ -f /etc/gaemigtp/alpaca.env && ! -L /etc/gaemigtp/alpaca.env ]] || fail "alpaca_credentials_missing_abort"
    if grep -El 'backend[./]alpaca_probe|alpaca_probe[.]py' /etc/systemd/system/gaemigtp-*.service /etc/systemd/system/gaemigtp-*.timer 2>/dev/null; then
      fail "alpaca_price_referenced_by_systemd_abort"
    fi
    p="$app/backend/alpaca_probe.py"
    if [[ -e "$p" || -L "$p" ]]; then
      [[ -f "$p" && ! -L "$p" ]] || fail "unexpected_price_file_type"
      [[ "$(blob_sha "$p")" == "664bee44240f2c6978bb70bd0f0918fdc036e4de" ]] || fail "unexpected_price_file_hash"
      rm -- "$p"
      echo ALPACA_PRICE_SOURCE_REMOVED
    else
      echo ALPACA_PRICE_SOURCE_ALREADY_ABSENT
    fi
    for c in "$app/backend/__pycache__/alpaca_probe.cpython-"*.pyc; do
      [[ -e "$c" || -L "$c" ]] || continue
      [[ -f "$c" && ! -L "$c" ]] || fail "unexpected_price_cache_type"
      rm -- "$c"
      echo ALPACA_PRICE_BYTECODE_REMOVED
    done
    [[ ! -e "$p" && ! -L "$p" ]] || fail "price_source_still_present"
    [[ -f "$app/backend/alpaca_news_probe.py" && -f /etc/gaemigtp/alpaca.env ]] || fail "news_or_credentials_changed"
    [[ "$(systemctl is-active gaemigtp-news.service || true)" == inactive ]] || fail "news_worker_changed"
    echo ALPACA_PRICE_REMOVE_PASS_NEWS_AND_CREDENTIALS_PRESERVED
    ;;
  status)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    systemctl --no-pager --plain status gaemigtp-news.service --lines=3 || true
    systemctl list-units --all --no-pager 'gaemigtp-*.service' 'gaemigtp-*.timer' || true
    ;;
  logs)
    [[ $# == 2 ]] || fail "logs_requires_unit_and_lines"
    valid_unit "$1" || fail "invalid_service"
    [[ "$2" =~ ^[0-9]{1,3}$ ]] && (( $2 >= 1 && $2 <= 300 )) || fail "invalid_log_lines"
    journalctl --no-pager -u "$1" -n "$2"
    ;;
  restart)
    [[ $# == 1 ]] || fail "restart_requires_unit"
    valid_unit "$1" || fail "invalid_service"
    systemctl restart "$1"
    systemctl is-active --quiet "$1" || fail "service_not_active"
    echo "GAEMI_SERVICE_RESTARTED=$1"
    ;;
  deploy)
    [[ $# == 2 ]] || fail "deploy_requires_destination_and_sha"
    dest="$1"
    valid_sha "$2" || fail "invalid_sha"
    # Paths must be inside the project tree or gaemigtp-specific systemd files.
    [[ "$dest" =~ ^(backend|frontend)/[A-Za-z0-9_./-]{1,210}$ || "$dest" == "app.py" ||
       "$dest" == "ops/staged_daily_groq_issues.py" ||
       "$dest" =~ ^ops/systemd/gaemigtp-[A-Za-z0-9_.@-]{1,90}\.(service|timer)$ ]] || fail "invalid_destination"
    [[ "$dest" != *".."* && "$dest" != *"//"* ]] || fail "path_traversal"
    [[ -f "$inbox" && ! -L "$inbox" ]] || fail "payload_missing"
    [[ "$(blob_sha "$inbox")" == "$2" ]] || fail "payload_sha_mismatch"
    if [[ "$dest" == ops/systemd/* ]]; then
      target=/etc/systemd/system/"$(basename "$dest")"
    else
      target="$app/$dest"
    fi
    [[ ! -L "$target" ]] || fail "destination_symlink"
    [[ -d "$(dirname "$target")" ]] || fail "destination_directory_missing"
    [[ -f "$target" || ! -e "$target" ]] || fail "destination_not_file"
    mkdir -p /var/backups/gaemi-gateway
    lock=/run/lock/gaemi-gateway.lock
    exec 8>"$lock"
    flock -n 8 || fail "concurrent_operation"
    stamp=$(date -u +%Y%m%dT%H%M%S)
    if [[ -f "$target" ]]; then
      cp -p -- "$target" "/var/backups/gaemi-gateway/$(basename "$target").$stamp.$2.before"
    fi
    tmp=$(mktemp "$(dirname "$target")/.gaemi-gateway.XXXXXXXX")
    trap 'rm -f "$tmp"' EXIT
    install -o root -g root -m 0644 -- "$inbox" "$tmp"
    [[ "$(blob_sha "$tmp")" == "$2" ]] || fail "copied_sha_mismatch"
    if [[ "$target" == *.py ]]; then
      /opt/gaemigtp-news/venv/bin/python -m py_compile "$tmp"
    fi
    mv -f -- "$tmp" "$target"
    trap - EXIT
    if [[ "$dest" == ops/systemd/* ]]; then
      systemctl daemon-reload
    fi
    echo "GAEMI_DEPLOY_OK=$dest"
    ;;
  kiwoom-verify)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    [[ -f /etc/gaemigtp/kiwoom.env && ! -L /etc/gaemigtp/kiwoom.env ]] || fail "kiwoom_credentials_not_installed"
    [[ "$(stat -c %U:%G /etc/gaemigtp/kiwoom.env)" == "root:root" ]] || fail "kiwoom_credentials_wrong_owner"
    [[ "$(stat -c %a /etc/gaemigtp/kiwoom.env)" == "600" ]] || fail "kiwoom_credentials_wrong_permissions"
    [[ -f "$app/backend/kiwoom_probe.py" && ! -L "$app/backend/kiwoom_probe.py" ]] || fail "kiwoom_probe_missing"
    [[ -f "$app/backend/providers/kiwoom_us_quotes.py" ]] || fail "kiwoom_provider_missing"
    systemctl is-active --quiet gaemigtp-news.service || fail "original_news_worker_inactive"
    exec 9>/run/lock/gaemi-kiwoom-verify.lock
    flock -n 9 || fail "kiwoom_verify_already_running"
    systemd-run --quiet --wait --pipe --collect \
      --unit="gaemi-kiwoom-verify-$(date -u +%s)" \
      -p User=gaemigtp-news -p Group=gaemigtp-news \
      -p WorkingDirectory="$app" \
      -p EnvironmentFile=/etc/gaemigtp/kiwoom.env \
      -p TimeoutStartSec=50 \
      /opt/gaemigtp-news/venv/bin/python -m backend.kiwoom_probe
    systemctl is-active --quiet gaemigtp-news.service || fail "original_worker_changed"
    echo "KIWOOM_VERIFY_PASS"
    ;;
  alpaca-news-verify)
    [[ $# == 0 ]] || fail "unexpected_arguments"
    [[ -f /etc/gaemigtp/alpaca.env && ! -L /etc/gaemigtp/alpaca.env ]] || fail "alpaca_credentials_not_installed"
    [[ "$(stat -c %U:%G /etc/gaemigtp/alpaca.env)" == "root:root" ]] || fail "alpaca_credentials_wrong_owner"
    [[ "$(stat -c %a /etc/gaemigtp/alpaca.env)" == "600" ]] || fail "alpaca_credentials_wrong_permissions"
    [[ -f "$app/backend/alpaca_news_probe.py" && ! -L "$app/backend/alpaca_news_probe.py" ]] || fail "alpaca_news_probe_missing"
    systemctl is-active --quiet gaemigtp-news.service || fail "original_news_worker_inactive"
    exec 9>/run/lock/gaemi-alpaca-news-verify.lock
    flock -n 9 || fail "alpaca_news_verify_already_running"
    systemd-run --quiet --wait --pipe --collect \
      --unit="gaemi-alpaca-news-verify-$(date -u +%s)" \
      -p User=gaemigtp-news -p Group=gaemigtp-news \
      -p WorkingDirectory="$app" \
      -p EnvironmentFile=/etc/gaemigtp/alpaca.env \
      -p TimeoutStartSec=45 \
      /opt/gaemigtp-news/venv/bin/python -m backend.alpaca_news_probe
    systemctl is-active --quiet gaemigtp-news.service || fail "original_worker_changed"
    echo ALPACA_NEWS_VERIFY_PASS
    ;;
  enable-timer)
    [[ $# == 1 && ( "$1" == "gaemigtp-kiwoom-us-value.timer" ||
                    "$1" == "gaemigtp-kiwoom-us-fe.service" ||
                    "$1" == "gaemigtp-kiwoom-us-daily.timer" ) ]] || fail "invalid_kiwoom_us_market_unit"
    [[ -f /etc/systemd/system/"$1" ]] || fail "market_unit_not_installed"
    systemctl enable --now "$1"
    systemctl is-enabled --quiet "$1" || fail "timer_not_enabled"
    systemctl is-active --quiet "$1" || fail "timer_not_active"
    echo "GAEMI_KIWOOM_VALUE_TIMER_ENABLED=$1"
    ;;
  upgrade)
    [[ $# == 1 ]] || fail "upgrade_requires_sha"
    valid_sha "$1" || fail "invalid_sha"
    [[ -f "$inbox" && ! -L "$inbox" ]] || fail "payload_missing"
    [[ "$(blob_sha "$inbox")" == "$1" ]] || fail "payload_sha_mismatch"
    bash -n "$inbox" || fail "upgrade_syntax_invalid"
    tmp=$(mktemp /usr/local/sbin/.gaemi-do-gateway.XXXXXXXX)
    trap 'rm -f "$tmp"' EXIT
    install -o root -g root -m 0750 -- "$inbox" "$tmp"
    [[ "$(blob_sha "$tmp")" == "$1" ]] || fail "upgrade_sha_mismatch"
    mv -f "$tmp" /usr/local/sbin/gaemi-do-gateway
    trap - EXIT
    echo "GAEMI_GATEWAY_UPGRADED=$1"
    ;;
  run)
    [[ $# == 3 ]] || fail "run_requires_request_id_sha_timeout"
    valid_req "$1" || fail "invalid_request"
    valid_sha "$2" || fail "invalid_sha"
    valid_timeout "$3" || fail "invalid_timeout"
    [[ -f "$inbox" && ! -L "$inbox" ]] || fail "payload_missing"
    [[ "$(blob_sha "$inbox")" == "$2" ]] || fail "payload_sha_mismatch"
    [[ -r "$envfile" ]] || fail "environment_missing"
    id gaemigtp-news >/dev/null || fail "service_user_missing"
    exec 9>/run/lock/gaemi-gateway.lock
    flock -n 9 || fail "concurrent_operation"
    install -d -o root -g root -m 0700 /var/lib/gaemi-gateway
    record="/var/lib/gaemi-gateway/run-$1"
    [[ ! -e "$record" ]] || fail "duplicate_run_request"
    # Record before external API calls, preventing accidental paid retries.
    printf '%s\n' "$(date -u +%FT%TZ) $2" > "$record"
    install -d -o gaemigtp-news -g gaemigtp-news -m 0700 /run/gaemi-gateway
    job="/run/gaemi-gateway/job-$1.py"
    install -o gaemigtp-news -g gaemigtp-news -m 0500 -- "$inbox" "$job"
    trap 'rm -f "$job"' EXIT
    unit="gaemi-gateway-$1"
    systemd-run --quiet --wait --pipe --collect \
      --unit="$unit" -p User=gaemigtp-news -p Group=gaemigtp-news \
      -p WorkingDirectory="$app" -p EnvironmentFile="$envfile" \
      -p TimeoutStartSec="$3" \
      /opt/gaemigtp-news/venv/bin/python "$job"
    echo "GAEMI_JOB_OK=$1"
    ;;
  kiwoom-daily-backfill)
    # Only the pinned 2026-10-26 recovery script may use BOTH existing secrets.
    [[ $# == 3 ]] || fail "backfill_requires_id_sha_timeout"
    [[ "$1" == "usdaily20261026recover3" ]] || fail "backfill_unapproved_request"
    [[ "$2" == "bd1c64a8ae0eb9f25214dbacea723bc4e5025db9" ]] || fail "backfill_unapproved_payload"
    [[ "$3" == "900" ]] || fail "backfill_unapproved_timeout"
    [[ -f "$inbox" && ! -L "$inbox" ]] || fail "backfill_payload_missing"
    [[ "$(blob_sha "$inbox")" == "$2" ]] || fail "backfill_payload_sha_mismatch"
    [[ -f /etc/gaemigtp/kiwoom.env && ! -L /etc/gaemigtp/kiwoom.env ]] || fail "backfill_kiwoom_env_missing"
    [[ "$(stat -c %U:%G /etc/gaemigtp/kiwoom.env)" == "root:root" ]] || fail "backfill_kiwoom_env_owner_invalid"
    [[ "$(stat -c %a /etc/gaemigtp/kiwoom.env)" == "600" ]] || fail "backfill_kiwoom_env_permissions_invalid"
    [[ -f "$envfile" && ! -L "$envfile" ]] || fail "backfill_database_env_missing"
    systemctl is-active --quiet gaemigtp-news.service || fail "backfill_original_worker_inactive"
    exec 9>/run/lock/gaemi-gateway.lock
    flock -n 9 || fail "backfill_concurrent_operation"
    install -d -o root -g root -m 0700 /var/lib/gaemi-gateway
    record="/var/lib/gaemi-gateway/run-$1"
    [[ ! -e "$record" ]] || fail "backfill_duplicate_request"
    printf '%s\n' "$(date -u +%FT%TZ) $2" > "$record"
    install -d -o gaemigtp-news -g gaemigtp-news -m 0700 /run/gaemi-gateway
    job="/run/gaemi-gateway/job-$1.py"
    install -o gaemigtp-news -g gaemigtp-news -m 0500 -- "$inbox" "$job"
    trap 'rm -f "$job"' EXIT
    systemd-run --quiet --wait --pipe --collect \
      --unit="gaemi-gateway-$1" \
      -p User=gaemigtp-news -p Group=gaemigtp-news \
      -p WorkingDirectory="$app" \
      -p EnvironmentFile=/etc/gaemigtp/kiwoom.env \
      -p EnvironmentFile=/etc/gaemigtp/news-worker.env \
      -p TimeoutStartSec=900 -p NoNewPrivileges=true \
      /opt/gaemigtp-news/venv/bin/python "$job"
    systemctl is-active --quiet gaemigtp-news.service || fail "backfill_original_worker_changed"
    echo "GAEMI_KIWOOM_BACKFILL_OK=$1"
    ;;
  *)
    fail "unknown_operation"
